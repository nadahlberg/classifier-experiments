{% load static %}{
  "name": "{{ site_config.site_name }}",
  "short_name": "{{ site_config.site_name }}",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#17161A",
  "theme_color": "#F4F1EA",
  "icons": [
    {
      "src": "{% static 'icons/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "{% static 'icons/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
